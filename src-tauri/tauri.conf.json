{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planner",
  "version": "2.2.0",
  "identifier": "com.planner.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Planner",
        "width": 1500,
        "height": 900,
        "minWidth": 920,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
